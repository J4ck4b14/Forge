{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@forge/core": ["./packages/core/src/index.ts"],
      "@forge/serialization": ["./packages/serialization/src/index.ts"],
      "@forge/runtime": ["./packages/runtime/src/index.ts"],
      "@forge/editor": ["./packages/editor/src/index.ts"],
      "@forge/assets": ["./packages/assets/src/index.ts"],
      "@forge/renderer": ["./packages/renderer/src/index.ts"],
      "@forge/renderer/pixi": ["./packages/renderer/src/pixi.ts"],
      "@forge/physics2d": ["./packages/physics2d/src/index.ts"],
      "@forge/input": ["./packages/input/src/index.ts"],
      "@forge/physics2d/rapier": ["./packages/physics2d/src/rapier.ts"],
      "@forge/scripting": ["./packages/scripting/src/index.ts"],
      "@forge/scripting/compiler": ["./packages/scripting/src/compiler.ts"],
      "@forge/graphs": ["./packages/graphs/src/index.ts"],
      "@forge/ui": ["./packages/ui/src/index.ts"],
      "@forge/persistence": ["./packages/persistence/src/index.ts"],
      "@forge/prefabs": ["./packages/prefabs/src/index.ts"],
      "@forge/animation": ["./packages/animation/src/index.ts"],
      "@forge/audio": ["./packages/audio/src/index.ts"],
      "@forge/player": ["./packages/player/src/index.ts"],
      "@forge/player/session": ["./packages/player/src/session.ts"]
    }
  },
  "include": ["packages", "examples", "tests", "vite.config.ts"]
}
